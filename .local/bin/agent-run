#!/usr/bin/env bash
# Run a coding agent TUI (claude, codex, or agy) with the wrapper defaults shared by zsh and
# nushell, then scroll the screen into scrollback like Ctrl-L unless it was a one-shot run.
# .config/wezterm/safe_close.lua looks through this wrapper to find the agent.
set -eu

if [ $# -lt 1 ]; then
	echo "usage: agent-run <claude|codex|agy> [args...]" >&2
	exit 2
fi
cmd="$1"
shift
cmd_args=("$@")

case "$cmd" in
claude)
	one_shot=" -p --print -h --help -v --version auth auto-mode doctor gateway import install logs mcp plugin plugins
		project respawn rm setup-token stop kill ultrareview update upgrade "
	;;
codex)
	one_shot=" -h --help -V --version exec e review login logout mcp plugin app-server remote-control completion update
		doctor sandbox debug apply a queue archive delete migrate-rollouts unarchive exec-server features help "

	# Profiles require embedded mode; request it explicitly to avoid a fallback warning.
	daemon_args=(--no-daemon)
	has_profile=0
	# The last matching subcommand decides.
	use_local=1
	for arg in "$@"; do
		case "$arg" in
		--no-daemon) daemon_args=() ;;
		-p | --profile | --profile=*) has_profile=1 ;;
		login | logout | plugin | mcp-server | app-server | remote-control | completion | update | doctor | features | help | apply | cloud | exec-server | debug)
			use_local=0
			;;
		prompt-input) use_local=1 ;;
		esac
	done
	if [ "$has_profile" = 1 ]; then
		cmd_args=("${daemon_args[@]}" "$@")
	elif [ "$use_local" = 1 ]; then
		cmd_args=("${daemon_args[@]}" --profile local "$@")
	fi
	;;
agy)
	one_shot=" -h --help -v -V --version -p --prompt models agents agent update upgrade help login logout auth doctor completion "
	agy_settings="${XDG_CONFIG_HOME:-$HOME/.config}/antigravity-cli/settings.base.json"
	has_settings=0
	use_settings=1
	skip_next=0
	for arg in "$@"; do
		if [ "$skip_next" = 1 ]; then
			skip_next=0
			continue
		fi
		case "$arg" in
		--settings)
			has_settings=1
			skip_next=1
			;;
		--settings=*) has_settings=1 ;;
		-p | --prompt | --model | --effort | --mode | --agent | --add-dir | --conversation | --cwd)
			skip_next=1
			;;
		-h | --help | -v | -V | --version | models | agents | agent | update | upgrade | help | login | logout | auth | doctor | completion)
			use_settings=0
			;;
		esac
	done
	if [ "$has_settings" = 0 ] && [ "$use_settings" = 1 ] && [ -f "$agy_settings" ]; then
		cmd_args=(--settings "$agy_settings" "$@")
	fi
	;;
*)
	one_shot=""
	;;
esac

# Let the agent handle Ctrl-C; the scrollback step below still runs.
trap : INT
status=0
command "$cmd" "${cmd_args[@]}" || status=$?

if [ -t 1 ]; then
	clear=1
	for arg in "$@"; do
		case "$one_shot" in
		*[[:space:]]"$arg"[[:space:]]*)
			clear=0
			break
			;;
		esac
		case "$arg" in
		-*) ;;
		*) break ;;
		esac
	done
	if [ "$clear" = 1 ]; then
		# Scroll the screen into scrollback instead of erasing it.
		rows=$(stty size </dev/tty 2>/dev/null | cut -d ' ' -f 1) || rows=""
		printf '%*s' "${rows:-0}" '' | tr ' ' '\n'
		printf '\e[H'
	fi
fi

exit "$status"

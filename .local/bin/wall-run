#!/usr/bin/env bash
# Run a command inside firejail with egress policy controlled by WALL_NET:
#   wall   : Phase 2 hard wall (own netns, kernel egress block) [default]
#   proxy  : cooperative allowlist proxy via env (fast)
#   1|open : file isolation + unrestricted network
#   none   : file isolation + no network at all
# Usage: wall-run [firejail-options...] -- <command> [args...]
set -eu

netfile="${XDG_CONFIG_HOME:-$HOME/.config}/firejail/nvim-egress.net"
proxy=""
proxy_env=()
firejail_args=(--quiet)

while [ $# -gt 0 ]; do
	if [ "$1" = "--" ]; then
		shift
		break
	fi
	firejail_args+=("$1")
	shift
done

if [ $# -lt 1 ]; then
	echo "usage: wall-run [firejail-options...] -- <command> [args...]" >&2
	exit 2
fi

firejail_bin=""
if [ -x /run/wrappers/bin/firejail ]; then
	firejail_bin=/run/wrappers/bin/firejail
elif command -v firejail >/dev/null 2>&1; then
	firejail_bin="$(command -v firejail)"
else
	# Fail closed: callers (snvim, plugupdate) rely on the sandbox.
	echo "wall-run: firejail not found; refusing to run unconfined" >&2
	exit 127
fi

case "${WALL_NET:-wall}" in
none)
	firejail_args+=(--net=none)
	;;
1 | open) ;;
proxy)
	if systemctl --user is-active --quiet tinyproxy-nvim 2>/dev/null; then
		proxy="http://127.0.0.1:8888"
	else
		echo "wall-run: tinyproxy-nvim not running -> egress UNFILTERED (file isolation still on)" >&2
	fi
	;;
*)
	if ! systemctl --user is-active --quiet tinyproxy-nvim 2>/dev/null; then
		echo "wall-run: tinyproxy-nvim not running; refusing to run in wall mode" >&2
		exit 1
	elif ! ip link show nvbr0 >/dev/null 2>&1 || [ ! -r "$netfile" ]; then
		echo "wall-run: egress bridge nvbr0 or $netfile unavailable; refusing to run in wall mode" >&2
		exit 1
	fi
	# Random host octet avoids clashes between concurrent instances.
	firejail_args+=(
		--net=nvbr0
		--ip="10.123.45.$(((RANDOM % 250) + 2))"
		--netfilter="$netfile"
	)
	proxy="http://10.123.45.1:8888"
	;;
esac

if [ -n "$proxy" ]; then
	proxy_env=(
		HTTPS_PROXY="$proxy" HTTP_PROXY="$proxy" ALL_PROXY="$proxy"
		https_proxy="$proxy" http_proxy="$proxy" all_proxy="$proxy"
		NO_PROXY= no_proxy=
	)
fi

exec env "${proxy_env[@]}" "$firejail_bin" "${firejail_args[@]}" "$@"

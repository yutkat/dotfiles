{
  "excludes": [
    "**/node_modules/**",
    "**/.git/**"
  ],
  "exec": {
    "associations": [
      "**/{.local/bin,.mise/tasks}/*"
    ],
    "commands": [
      {
        "command": "stylua --stdin-filepath {{file_path}} -",
        "exts": ["lua", "luau"]
      },
      {
        "command": "shuck format --stdin-filename {{file_path}} -",
        "exts": ["sh", "bash", "zsh"],
        "fileNames": [".zshenv", ".zshrc", ".zprofile", ".zlogin", ".zlogout"],
        "associations": [
          "**/{.local/bin,.mise/tasks}/*"
        ]
      },
      {
        "command": "nixfmt",
        "exts": ["nix"]
      },
      {
        "command": "biome format --stdin-file-path {{file_path}}",
        "exts": ["js", "jsx", "ts", "tsx", "mjs", "cjs", "mts", "cts", "json", "jsonc"]
      },
      {
        // Only the first matching command runs, so prettier + rumdl are chained in one script.
        "command": "markdown-fmt {{file_path}}",
        "exts": ["md", "markdown"]
      },
      {
        "command": "prettier --stdin-filepath {{file_path}}",
        "exts": ["yaml", "yml", "css", "scss", "less", "html", "graphql", "vue"]
      },
      {
        "command": "ruff format --stdin-filename {{file_path}} -",
        "exts": ["py", "pyi"]
      },
      {
        "command": "rustfmt",
        "exts": ["rs"]
      }
    ]
  },
  "plugins": [
    "npm:@dprint/exec@0.9.0/plugin.json@d4f708dc00798b51013ca4e7c26a86656bfb31e7255cdcde28a487f86813e34d"
  ]
}

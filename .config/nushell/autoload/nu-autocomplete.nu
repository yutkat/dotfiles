# Carapace completions for external commands; fall back to file completion when it has none.
$env.config.completions.external.enable = true
$env.config.completions.external.completer = {|place|
  let candidates = try {
    CARAPACE_LENIENT=1 carapace $place.command.0 nushell ...$place.command | from json
  } catch { null }
  if ($candidates | is-empty) { null } else { $candidates }
}
# Carapace has no mise completer; mise's script (generated by scripts/init.nu) takes `mise` and passes the rest on.
const mise_completion = $nu.data-dir | path join completions mise.nu
source (if ($mise_completion | path exists) { $mise_completion } else { null })

# https://github.com/yutkat/nu-autocomplete, cloned by scripts/install.nu; `use null` keeps startup working when the clone failed.
const nu_autocomplete = $nu.data-dir | path join modules nu-autocomplete nu-autocomplete
const nu_autocomplete_mod = if ($nu_autocomplete | path exists) { $nu_autocomplete } else { null }
use $nu_autocomplete_mod
# Not cached here: the menu source `enable` installs is a closure, which cannot be serialized, and
# `enable` caches its generated keybindings on disk itself.
if $nu_autocomplete_mod != null {
  # Enter accepts too; a clone that rejects these accept keys falls back to the defaults until `nu-modules-update`.
  try { nu-autocomplete enable --accept-keys [Enter ctrl+y] } catch { nu-autocomplete enable }
}

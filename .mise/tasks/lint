#!/usr/bin/env bash
#MISE description="Run all repository lint checks (CI parity with lint.yml)"
#MISE tools={"biome" = "latest", "github:ewhauser/shuck" = "latest", "github:NixOS/nixfmt" = "latest", "github:rhysd/actionlint" = "latest", "nushell" = "latest", "stylua" = "latest"}
set -euo pipefail

# Tracked shell scripts: *.sh, mise tasks, and extensionless files with a sh shebang
shell_scripts() {
	git ls-files -z -- '*.sh' '.mise/tasks/*'
	git ls-files -z -- ':(glob,exclude)**/*.*' ':(exclude).mise/tasks' |
		while IFS= read -r -d '' f; do
			[ -f "$f" ] || continue
			case "$(head -n 1 "$f")" in
			'#!'*sh | '#!'*sh' '*) printf '%s\0' "$f" ;;
			esac
		done
}

echo "==> shuck check (zsh config)"
shuck check .zshenv .config/zsh

echo "==> shuck check (shell scripts)"
shell_scripts | xargs -0 -r shuck check

echo "==> shuck format --diff (zsh config)"
shuck format --diff .zshenv .config/zsh

echo "==> shuck format --diff (shell scripts)"
shell_scripts | xargs -0 -r shuck format --diff

echo "==> stylua --check (*.lua)"
git ls-files -z -- '*.lua' | xargs -0 -r stylua --check

echo "==> nixfmt --check (*.nix)"
git ls-files -z -- '*.nix' | xargs -0 -r nixfmt --check

echo "==> shuck check (GitHub Actions run: blocks)"
shuck check .github/workflows .github/actions

# shuck covers run: blocks; disable shellcheck so local and CI runs match.
echo "==> actionlint (GitHub workflows)"
actionlint -shellcheck=

echo "==> biome lint (*.json, *.jsonc)"
# .config/biome/biome.jsonc is validated when loaded via --config-path and cannot be passed as a nested root.
git ls-files -z -- '*.json' '*.jsonc' ':(exclude).config/biome/biome.jsonc' |
	xargs -0 -r biome lint --config-path .config/biome/biome.jsonc

echo "==> nu --ide-check (*.nu)"
nu_failed=0
while IFS= read -r -d '' f; do
	diags=$(nu --include-path "$PWD/.config/nushell/scripts" --no-config-file --ide-check 100 "$f" |
		jq -c 'select(.type == "diagnostic")')
	if [ -n "$diags" ]; then
		printf '%s\n%s\n' "$f" "$diags" >&2
		nu_failed=1
	fi
done < <(git ls-files -z -- '*.nu')
[ "$nu_failed" -eq 0 ]

echo "All lint checks passed"
